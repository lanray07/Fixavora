# Development-only optional translation gateway. Never copied into the APK.
TRANSLATION_ENDPOINT=
TRANSLATION_API_KEY=
# HTTPS receipt-verification service URL, public address compiled into the app.
FIXAVORA_RECEIPT_ENDPOINT=
# Server-only Amazon shared secret. NEVER add to Gradle, resources, or client assets.
AMAZON_SHARED_SECRET=
AMAZON_RVS_ENV=production
