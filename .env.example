# Development-only optional translation gateway. Never copied into the APK.
TRANSLATION_ENDPOINT=
TRANSLATION_API_KEY=
# Receipt URLs are fixed by Android build type in app/build.gradle.kts.
# Cloudflare uses an encrypted Worker secret; these variables are for the
# optional standalone Python server only, never for the Android build.
# Server-only Amazon shared secret. NEVER add to Gradle, resources, or client assets.
AMAZON_SHARED_SECRET=
AMAZON_RVS_ENV=production
